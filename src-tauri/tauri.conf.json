{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BytePet Tauri Preview",
  "version": "0.2.0-preview.1",
  "identifier": "app.bytepet.tauri.preview",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri.mjs",
    "beforeBuildCommand": "node scripts/prepare-tauri.mjs",
    "frontendDist": "../build/tauri-web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "local-ui",
          "windows": [
            "pet",
            "panel",
            "badge"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
