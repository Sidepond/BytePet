{
  "name": "bytepet",
  "productName": "BytePet",
  "version": "0.2.0-preview.1",
  "private": true,
  "description": "A pixel desktop pet for developers",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "sprites:marmalade": "node scripts/pixellab-new-character.mjs",
    "build:marmalade": "node scripts/build-marmalade-preview.mjs",
    "sprites:character": "node scripts/pixellab-new-character.mjs",
    "build:character": "node scripts/build-marmalade-preview.mjs",
    "sprites:pack": "node scripts/generate-pixellab-pack.mjs",
    "build:characters": "node scripts/build-character-gallery.mjs",
    "sync:characters": "node scripts/sync-character-assets.mjs",
    "package:mac": "tauri build",
    "test": "npm run test:unit && npm run test:tauri",
    "test:desktop": "npm run test:tauri:desktop",
    "sprites:eating": "node scripts/generate-pixellab-eating.mjs",
    "sprites:dragging": "node scripts/generate-pixellab-dragging.mjs",
    "package:preview": "node scripts/package-tauri-preview.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:tauri:desktop": "node scripts/prepare-tauri.mjs && cargo build --manifest-path src-tauri/Cargo.toml && node --test --test-concurrency=1 tests/tauri-runtime.test.mjs",
    "package:tauri:preview": "node scripts/package-tauri-preview.mjs",
    "build": "tauri build",
    "test:unit": "node --test tests/pet.test.mjs tests/jwt.test.mjs tests/json.test.mjs tests/format.test.mjs tests/results.test.mjs tests/usage.test.mjs",
    "build:icon": "node scripts/create-icon.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "playwright": "1.64.1"
  }
}
