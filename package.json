{
  "name": "bytepet",
  "productName": "BytePet",
  "version": "0.1.0",
  "private": true,
  "description": "A pixel desktop pet for developers",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:sprites": "node scripts/build-sprite-preview.mjs",
    "sprites:pixellab": "node scripts/pixellab-sprites.mjs",
    "build:pixellab": "node scripts/build-pixellab-preview.mjs",
    "sprites:marmalade": "node scripts/pixellab-new-character.mjs",
    "build:marmalade": "node scripts/build-marmalade-preview.mjs",
    "sprites:character": "node scripts/pixellab-new-character.mjs",
    "build:character": "node scripts/build-marmalade-preview.mjs",
    "sprites:pack": "node scripts/generate-pixellab-pack.mjs",
    "build:characters": "node scripts/build-character-gallery.mjs",
    "sync:characters": "node scripts/sync-character-assets.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "test:package": "node --test tests/package.test.mjs",
    "test": "node --test tests/pet.test.mjs tests/food.test.mjs tests/jwt.test.mjs tests/json.test.mjs tests/format.test.mjs tests/results.test.mjs tests/ports.test.mjs tests/terminate.test.mjs tests/modules.test.mjs tests/appearance.test.mjs tests/usage.test.mjs",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "sprites:eating": "node scripts/generate-pixellab-eating.mjs",
    "sprites:dragging": "node scripts/generate-pixellab-dragging.mjs",
    "test:usage-desktop": "node --test tests/usage-desktop.test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "playwright": "1.64.1"
  }
}
